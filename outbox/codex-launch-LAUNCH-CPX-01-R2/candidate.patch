+    // 선택된 지시서 사이에서 한 지시서의 쓰기 대상과 다른 지시서의 pin 충돌을 찾는다.
+    private static JsonArray FindCrossDirectivePinCollisions(List<string> directives)
+    {
+        var descriptions = new List<(string DiId, List<string> Allowlist, List<string> RequiredInputs)>();
+        foreach (var directive in directives)
+        {
+            var text = File.ReadAllText(directive);
+            var packText = ExtractContextPack(text);
+            if (packText is null) continue;
+
+            JsonObject? pack;
+            try
+            {
+                pack = JsonNode.Parse(packText) as JsonObject;
+            }
+            catch (JsonException)
+            {
+                continue;
+            }
+
+            if (pack is null) continue;
+            var requiredInputs = (pack["requiredInputs"] as JsonArray)?
+                .OfType<JsonObject>()
+                .Select(item => ReadString(item, "path").Replace('\\', '/'))
+                .Where(path => !string.IsNullOrWhiteSpace(path))
+                .Distinct(StringComparer.OrdinalIgnoreCase)
+                .ToList() ?? [];
+            descriptions.Add((ReadString(pack, "diId"), ParseAllowlist(text), requiredInputs));
+        }
+
+        var collisions = new JsonArray();
+        foreach (var writer in descriptions)
+        {
+            foreach (var pinned in descriptions.Where(item =>
+                !item.DiId.Equals(writer.DiId, StringComparison.OrdinalIgnoreCase)))
+            {
+                foreach (var path in pinned.RequiredInputs.Where(path => AllowlistOverlaps(path, writer.Allowlist)))
+                {
+                    collisions.Add(new JsonObject
+                    {
+                        ["code"] = "cross-directive-pin-collision",
+                        ["path"] = path,
+                        ["writtenBy"] = writer.DiId,
+                        ["pinnedBy"] = pinned.DiId,
+                    });
+                }
+            }
+        }
+
+        return collisions;
+    }
